# Shared API origin
BASE_URL=http://localhost:3000

# Login credentials (preferred) — POST ${AUTH_LOGIN_PATH} → token at ${AUTH_TOKEN_JQ}
AUTH_EMAIL=
AUTH_PASSWORD=
# Aliases also accepted by auth.sh:
# AUTH_USERNAME=

# Or paste a JWT and skip login:
# ACCESS_TOKEN=

# Optional overrides
# AUTH_LOGIN_PATH=/auth/login
# AUTH_TOKEN_JQ=.accessToken
# API_AUTH_HEADER=Authorization
# API_AUTH_SCHEME=Bearer
